# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ad-platform

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Server Configuration
PORT=5500

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
